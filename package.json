{
  "name": "vatsim-atc",
  "version": "0.1.0",
  "private": true,
  "description": "VATSIM ATC coverage prediction — vatsim-atc.com",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @vatsim-atc/core db:generate",
    "db:migrate": "pnpm --filter @vatsim-atc/core db:migrate",
    "db:seed": "pnpm --filter @vatsim-atc/core db:seed",
    "airports:build": "node scripts/build-airports.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
