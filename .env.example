# Postgres connection string used by the collector, web app, and Drizzle tooling.
DATABASE_URL=postgres://vatsim:vatsim@localhost:5432/vatsim_atc

# Contact email advertised in the collector's User-Agent to the VATSIM datafeed.
CONTACT_EMAIL=you@example.com

# Datafeed poll interval in milliseconds (spec default: 60s).
POLL_INTERVAL_MS=60000

# Web app port (Next.js dev server and docker-compose host mapping).
PORT=3000

# Historical backfill (apps/collector — manual one-shot script).
BACKFILL_WEEKS=30
BACKFILL_PAGE_SIZE=250
BACKFILL_DELAY_MS=1000

# Discord bot (apps/bot) — phase 2 scaffold.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Base URL the bot uses to reach the web app's public API.
WEB_API_URL=http://localhost:3000
